upscholar_nlp/data/*.npy
upscholar_nlp/data/matriz_*.csv
upscholar_nlp/data/processed_*.csv
upscholar_nlp/data/top10*.csv
upscholar_nlp/data/recomendaciones*.csv
upscholar_nlp/data/embedding_metadata.csv
